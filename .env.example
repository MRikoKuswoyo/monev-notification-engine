# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN di-commit ke GitHub.
# Supabase: Dashboard -> tombol "Connect" -> "Session pooler" -> salin URI, ganti [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Pengingat Telegram (buat bot lewat @BotFather, salin token-nya)
TELEGRAM_BOT_TOKEN=
MONEV_USER_NAME=Riko
REMINDER_NAG_MINUTES=10
